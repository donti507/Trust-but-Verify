<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>Synthetic Swap Confirmation</title>
<style>
@page { size: A4; margin: 16mm; }
body { font-family: sans-serif; font-size: 9pt; line-height: 1.3; color: #111; }
.disclaimer { font-size: 9pt; margin: 0 0 12pt; white-space: nowrap; }
h1 { font-size: 16pt; } h2 { font-size: 11pt; margin: 12pt 0 5pt; }
p { margin: 5pt 0; } .term { break-inside: avoid; }
a.value, span.value { color: inherit; text-decoration: none; white-space: nowrap; }
table { width: 100%; border-collapse: collapse; } tr { break-inside: avoid; }
th, td { padding: 3pt 5pt; border-bottom: 0.5pt solid #bbb; text-align: left; }
th { width: 39%; font-weight: normal; }
.dealer { font-family: monospace; } .compact { font-size: 8pt; }
</style></head><body>
<p class="disclaimer">{{ disclaimer }}</p>
{% macro value(row) -%}
{% if markers %}<a class="value" href="urn:trustswap:field:{{ row.path }}">{{ row.text }}</a>{% else %}<span class="value">{{ row.text }}</span>{% endif %}
{%- endmacro %}
{% block content %}{% endblock %}
</body></html>
